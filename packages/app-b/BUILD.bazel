load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//packages/app-b:vite/package_json.bzl", vite = "bin")
load("@npm//packages/app-b:vitest/package_json.bzl", vitest = "bin")

npm_link_all_packages(name = "node_modules")

exports_files(
    ["package.json"],
    visibility = ["//visibility:public"],
)

_SRCS = glob([
    "src/**/*.css",
    "src/**/*.ts",
    "src/**/*.tsx",
])

js_library(
    name = "srcs",
    srcs = _SRCS + [
        "index.html",
        "package.json",
        "tsconfig.app.json",
        "tsconfig.json",
        "tsconfig.node.json",
        "vite.config.ts",
        "//:tsconfig_base",
    ],
)

vite.vite(
    name = "bundle",
    srcs = [
        ":node_modules",
        ":srcs",
    ],
    args = ["build"],
    chdir = package_name(),
    out_dirs = ["dist"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

vitest.vitest_test(
    name = "test",
    size = "small",
    args = [
        "run",
        "--config=vite.config.ts",
        "--cache=false",
    ],
    chdir = package_name(),
    data = [
        ":node_modules",
        ":srcs",
    ],
)
