{
  "name": "@gh-actions/app-a",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --project unit",
    "test:visual": "vitest run --project vrt --reporter=default --reporter=html",
    "test:visual:new": "vitest run --project vrt --update=new",
    "test:visual:open": "vitest --project vrt --browser.headless=false --test-timeout=0",
    "test:visual:debug": "vitest --project vrt --browser.headless=false --inspect-brk --no-file-parallelism --test-timeout=0",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@gh-actions/lib-a": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "typescript": "catalog:",
    "vite": "^8.2.2",
    "vitest": "catalog:",
    "vitest-browser-react": "^2.3.0"
  }
}
